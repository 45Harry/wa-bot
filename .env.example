# ── OpenCode Zen (OpenAI-compatible LLM gateway) ───────────────────────────
# Required. Your OpenCode Zen API key.
# Sent as:  Authorization: Bearer $OPENCODE_API_KEY
OPENCODE_API_KEY=

# Optional. Model id, used verbatim as the `model` field.
# Defaults to claude-sonnet-4-5 when unset.
#
# NOTE: use the BARE id, with no "opencode/" prefix. Verified against the live
# API — "opencode/claude-sonnet-4-5" is rejected with
#   {"type":"ModelError","message":"Model opencode/... is not supported"}
# See the full catalog: curl https://opencode.ai/zen/v1/models
OPENCODE_MODEL=claude-sonnet-4-5

# ── WhatsApp ───────────────────────────────────────────────────────────────
# Required on first run only (for pairing). Your own number, with country code,
# digits only — no +, spaces, dashes or parentheses.
WHATSAPP_NUMBER=
